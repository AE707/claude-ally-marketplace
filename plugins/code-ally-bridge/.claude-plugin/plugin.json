{
  "name": "code-ally-bridge",
  "description": "Routes file creation requests from Claude to Code Ally",
  "version": "1.0.0",
  "author": {
    "name": "Your Name"
  },
  "tools": [
    {
      "name": "ally_write",
      "description": "Write a file using Code Ally",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The file path to write"
          },
          "content": {
            "type": "string",
            "description": "The content to write to the file"
          }
        },
        "required": ["path", "content"]
      }
    },
    {
      "name": "ally_mkdir",
      "description": "Create a folder using Code Ally",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The folder path to create"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "ally_exec",
      "description": "Execute a shell command using Code Ally",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The shell command to execute"
          }
        },
        "required": ["command"]
      }
    }
  ]
}